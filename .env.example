# --------------------------------------------------------------------------
# Residency Training Console — environment template
#
# Copy to `.env` and edit. Every value is optional except RTC_SECRET_KEY in a
# real deployment; the defaults run the platform on SQLite with no other
# infrastructure at all.
# --------------------------------------------------------------------------

# ---- Environment ---------------------------------------------------------
# local | development | staging | production
RTC_ENV=local

# ---- Database ------------------------------------------------------------
# Default is SQLite in backend/rtc.db. For production use PostgreSQL:
# RTC_DATABASE_URL=postgresql+psycopg://rtc:password@localhost:5432/rtc
# RTC_DB_POOL_SIZE=10
# RTC_DB_MAX_OVERFLOW=20

# ---- Supabase ------------------------------------------------------------
# You need BOTH connection strings, and using the wrong one is the most common
# deployment failure. Supabase → Project Settings → Database → Connection string.
# Swap the driver prefix to `postgresql+psycopg://`, and URL-encode the password
# if it contains @ : / # ? or &.
#
#   Port 6543 — TRANSACTION pooler. For the deployed application.
#   Port 5432 — SESSION pooler.     For Alembic migrations and the scripts.
#
# The app disables prepared statements automatically on 6543, because PgBouncer's
# transaction mode gives each transaction a different backend connection.
#
# RTC_DATABASE_URL=postgresql+psycopg://postgres.abcdefgh:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
#
# Force the serverless strategy (no in-process pool). Auto-detected from VERCEL
# or AWS_LAMBDA_FUNCTION_NAME when unset.
# RTC_DB_SERVERLESS=true

# ---- Security ------------------------------------------------------------
# REQUIRED in production. Sessions are signed with this; rotating it signs
# everyone out. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
RTC_SECRET_KEY=change-me-before-any-real-deployment
RTC_ACCESS_TOKEN_TTL_MINUTES=30
RTC_REFRESH_TOKEN_TTL_DAYS=14
RTC_PASSWORD_MIN_LENGTH=12
RTC_MAX_FAILED_LOGINS=6
RTC_LOCKOUT_MINUTES=15

# ---- CORS ----------------------------------------------------------------
# Comma-separated. Not needed when Nginx serves both the app and the API.
RTC_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Object storage (S3 compatible) --------------------------------------
# RTC_S3_ENDPOINT_URL=http://localhost:9000
# RTC_S3_BUCKET=rtc-artifacts
# RTC_S3_ACCESS_KEY=
# RTC_S3_SECRET_KEY=
# RTC_S3_REGION=us-east-1

# ---- Feature flags -------------------------------------------------------
# MUST be false in production: the seeder creates accounts with known passwords.
RTC_ALLOW_DEMO_SEED=true
RTC_ENABLE_WEBSOCKETS=true
RTC_ENABLE_AI_ASSISTANT=false
# RTC_AI_PROVIDER_BASE_URL=
# RTC_AI_API_KEY=

# ---- AI content generation -----------------------------------------------
# Off by default. With it off the whole generation workflow still runs against
# a deterministic offline provider, so you can watch the pipeline end to end —
# generate, validate, deduplicate, review, release — before spending anything.
# The API reports `is_offline_placeholder: true` so nobody mistakes placeholder
# output for clinical content.
RTC_ENABLE_AI_GENERATION=false
# Model id, complete as written. Never append a date suffix.
# RTC_AI_MODEL=claude-opus-5
# low | medium | high | xhigh | max
# RTC_AI_EFFORT=high
# Caps thinking plus visible output on one call.
# RTC_AI_MAX_OUTPUT_TOKENS=32000
# Items requested per model call.
# RTC_AI_BATCH_SIZE=10
# Hard ceiling per generation job, in US dollars. Checked *before* each call,
# so a runaway loop stops rather than bills.
# RTC_AI_JOB_COST_CEILING_USD=5.0
# Published rates, used for the estimate recorded on each job. Override if your
# contract differs.
# RTC_AI_INPUT_COST_PER_MTOK=5.0
# RTC_AI_OUTPUT_COST_PER_MTOK=25.0
# Retry a safety-declined request on a fallback model. Benign clinical and
# pharmacology content occasionally trips a classifier; without this a declined
# request simply stops.
# RTC_AI_ENABLE_FALLBACKS=true
# The service level a job is measured against. Breaches are recorded on the job,
# not hidden. Meeting it needs the background worker — see docs/DEPLOYMENT_VERCEL.md
# for why serverless cannot.
# RTC_AI_GENERATION_DEADLINE_MINUTES=20

# ---- Offline sync --------------------------------------------------------
RTC_SYNC_PAGE_SIZE=500

# ==========================================================================
# Docker Compose only
# ==========================================================================
POSTGRES_USER=rtc
POSTGRES_PASSWORD=rtc_local_password
POSTGRES_DB=rtc
WEB_PORT=8080
MINIO_CONSOLE_PORT=9001
S3_ACCESS_KEY=rtc_minio
S3_SECRET_KEY=rtc_minio_password
S3_BUCKET=rtc-artifacts
RTC_SEED_ON_START=true
SHOW_DEMO_ACCOUNTS=true

# ==========================================================================
# Frontend build-time (Vite)
# ==========================================================================
# VITE_API_BASE=/api/v1
# VITE_API_PROXY=http://localhost:8000
# VITE_SHOW_DEMO_ACCOUNTS=false

# ==========================================================================
# Vercel — set these in the Vercel dashboard, not in a file
# ==========================================================================
# RTC_DATABASE_URL          the 6543 (transaction pooler) URI
# RTC_SECRET_KEY            48+ random characters
# RTC_ENV                   production
# RTC_ALLOW_DEMO_SEED       false
# VITE_SHOW_DEMO_ACCOUNTS   false
#
# RTC_CORS_ORIGINS is not needed on Vercel: the app and API share one origin.

# ==========================================================================
# GitHub Actions secrets
# ==========================================================================
# VERCEL_TOKEN               Vercel → Account Settings → Tokens
# VERCEL_ORG_ID              .vercel/project.json after `vercel link`
# VERCEL_PROJECT_ID          same file
# RTC_DATABASE_URL_SESSION   the 5432 URI — migrations only
# RTC_SECRET_KEY             identical to the Vercel value
# RTC_BASE_URL               https://your-app.vercel.app
# RTC_SERVICE_EMAIL          service account for scheduled maintenance
# RTC_SERVICE_PASSWORD       its password (do not enable MFA on it)

